# Base relationnelle (MySQL / Aiven en production)
DB_HOST=db
DB_PORT=3306
DB_NAME=setly
DB_USER=setly
DB_PASSWORD=setly_pass

# Base non relationnelle (MongoDB / MongoDB Atlas en production)
MONGODB_URI=mongodb://mongo:27017
MONGO_DB=setly_stats

# Application
APP_ENV=local
APP_URL=http://localhost:8080

# Variables ci-dessous : uniquement pour un deploiement (Render), jamais en local.
# APP_ENV=production
# DB_SSL_CA=           # contenu du certificat CA MySQL Aiven (ca.pem), colle tel quel
# MONGODB_URI=         # URI Atlas (mongodb+srv://...), a definir dans le tableau de bord Render
